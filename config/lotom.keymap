#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

/ {
    behaviors {
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        tab_slide: behavior_sensor_rotate_tab_slide {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_TAB_SLIDE";
            #sensor-binding-cells = <0>;
            bindings = <&kp LA(LG(RIGHT_ARROW))>, <&kp LA(LG(LEFT_ARROW))>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC         &kp GRAVE
&kp GRAVE       &kp Q         &kp W               &kp E               &kp R        &kp T      &kp Y      &kp U        &kp I      &kp O       &kp P          &kp BACKSPACE
&kp TAB         &kp A         &kp S               &kp D               &kp F        &kp G      &kp H      &kp J        &kp K      &kp L       &kp SEMICOLON  &kp ENTER
&kp LEFT_SHIFT  &kp Z         &kp X               &kp C               &kp V        &kp B      &kp N      &kp M        &mkp LCLK  &mkp RCLK   &kp SLASH      &kp MINUS
&kp LCTRL       &kp LEFT_ALT  &lt 5 LEFT_COMMAND  &lt 4 LEFT_COMMAND  &lt 5 LANG2  &kp SPACE  &kp SPACE  &lt 2 LANG1  &kp COMMA  &kp PERIOD
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };

        ARROW {
            bindings = <
&trans     &trans
&trans     &trans        &trans            &trans          &trans     &trans  &trans  &kp LS(LG(NUMBER_4))    &kp LS(LG(N5))  &kp LG(LS(NUMBER_6))     &trans  &kp BACKSPACE
&trans     &trans        &trans            &trans          &trans     &trans  &trans  &kp LC(LA(LEFT_ARROW))  &kp UP_ARROW    &kp LC(LA(RIGHT_ARROW))  &trans  &kp ENTER
&trans     &trans        &trans            &kp LG(C)       &kp LA(V)  &trans  &trans  &kp LEFT_ARROW          &mkp LCLK       &mkp RCLK                &trans  &trans
&kp LCTRL  &kp LEFT_ALT  &kp LEFT_COMMAND  &kp LEFT_SHIFT  &trans     &trans  &trans  &mo 3                   &trans          &trans
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };

        SCROLL {
            bindings = <
&trans      &trans
&kp ESCAPE  &trans  &trans  &trans  &kp EXCLAMATION  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AT_SIGN  &kp HASH              &kp DOLLAR     &kp PIPE   &kp BACKSPACE
&trans      &trans  &trans  &trans  &kp PERCENT      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp LCTRL    &kp ASTERISK          &kp SEMICOLON  &kp COLON  &kp ENTER
&kp F12     &trans  &trans  &trans  &kp AMPERSAND    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp TILDE    &kp COMMA             &kp PERIOD     &kp SLASH  &kp QUESTION
&kp F12     &trans  &trans  &trans  &kp GRAVE        &kp LESS_THAN         &kp GREATER_THAN       &trans       &kp NON_US_BACKSLASH  &trans
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };

        FUNCTION {
            bindings = <
&trans     &trans
&kp GRAVE  &kp LC(LS(TAB))         &kp LG(RIGHT)  &kp NUMBER_9             &kp NUMBER_0       &trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &kp BACKSPACE
&kp TAB    &kp LA(LG(LEFT_ARROW))  &kp LG(LEFT)   &kp LG(LA(RIGHT_ARROW))  &kp LEFT_BRACKET   &trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &kp ENTER
&kp LCMD   &kp LG(LS(LEFT_ARROW))  &trans         &kp LG(LS(RIGHT_ARROW))  &kp RIGHT_BRACKET  &trans  &kp F11  &kp F12  &trans  &trans  &trans   &trans
&trans     &trans                  &trans         &trans                   &trans             &trans  &trans   &trans   &trans  &trans
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };

        NUM {
            bindings = <
&trans                   &trans
&kp GRAVE                &kp NUMBER_7  &kp NUMBER_8  &kp LG(LS(NUMBER_4))  &kp PLUS      &trans  &kp N7        &kp N8          &kp N9        &kp SLASH  &kp ASTERISK  &kp BACKSPACE
&kp SLASH                &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6          &kp ASTERISK  &trans  &kp NUMBER_4  &kp N5          &kp NUMBER_6  &kp MINUS  &kp PLUS      &kp ENTER
&mt LEFT_SHIFT NUMBER_0  &kp NUMBER_1  &kp LG(C)     &kp NUMBER_3          &kp PERIOD    &trans  &kp NUMBER_1  &kp NUMBER_2    &kp NUMBER_3  &kp N0     &kp PERIOD    &kp EQUAL
&trans                   &trans        &trans        &trans                &trans        &trans  &trans        &kp LEFT_SHIFT  &trans        &trans
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };

        OTHER {
            bindings = <
&kp ESC  &kp GRAVE
&trans   &trans     &trans  &trans  &kp EXCLAMATION  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LS(LG(NUMBER_4))    &kp LS(LG(N5))  &kp LS(LG(NUMBER_6))     &kp PIPE   &kp BACKSPACE
&trans   &trans     &trans  &trans  &kp PERCENT      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp LC(LA(LEFT_ARROW))  &kp UP_ARROW    &kp LC(LA(RIGHT_ARROW))  &kp COLON  &kp ENTER
&trans   &trans     &trans  &trans  &kp AMPERSAND    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp SLASH  &kp QUESTION
&trans   &trans     &trans  &trans  &kp GRAVE        &kp LESS_THAN         &kp GREATER_THAN       &kp GRAVE               &kp BACKSLASH   &trans
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };

        BT {
            bindings = <
&trans         &trans
&kp LG(Q)      &kp LC(W)  &trans     &trans     &trans  &trans  &trans  &bt BT_PRV  &bt BT_NXT  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp LG(LS(Z))  &trans     &kp LC(C)  &trans     &trans  &trans  &trans  &trans      &trans      &trans        &trans        &trans
&kp LG(Z)      &kp LG(X)  &kp LG(C)  &kp LG(V)  &trans  &trans  &trans  &trans      &trans      &trans        &trans        &trans
&trans         &trans     &trans     &trans     &trans  &trans  &trans  &trans      &trans      &trans
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };
    };
};
